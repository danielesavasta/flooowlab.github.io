---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base title="Projects" description="Interactive installations and systems built at Flowlab.">
  <h1>Projects</h1>
  <p class="lede">Interactive installations and the systems behind them.</p>

  {projects.map((p) => (
    <article>
      <h3>{p.title}</h3>
      <p class="meta">{p.status}{p.tech && ` · ${p.tech.join(', ')}`}</p>
      <p>{p.summary}</p>
    </article>
  ))}
</Base>
